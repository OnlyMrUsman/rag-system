# =============================================================
# RAG System — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                    # Leave empty for local
QDRANT_COLLECTION_NAME=rag_docs

# --- LLM (Ollama local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda              # or "cpu" if no GPU

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Search ---
DENSE_SEARCH_LIMIT=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.7                   # 0=BM25 only, 1=dense only

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
